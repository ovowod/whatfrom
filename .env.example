WHATFROM_DATABASE_URL=postgresql+psycopg://whatfrom:whatfrom@localhost:5432/whatfrom
WHATFROM_TEST_DATABASE_URL=postgresql+psycopg://whatfrom:whatfrom@localhost:5432/whatfrom_test
# 임베딩. 1024차원을 내는 모델이어야 한다 (스키마가 Vector(1024)로 고정).
# 로컬이면 먼저 `ollama pull bge-m3`.
WHATFROM_EMBEDDER=fake
WHATFROM_EMBEDDING_BASE_URL=http://localhost:11434/v1
WHATFROM_EMBEDDING_MODEL=bge-m3
WHATFROM_EMBEDDING_API_KEY=

# OpenAI 호환 엔드포인트. base_url만 바꿔 vLLM·Ollama·Kimi·호스팅 API를 오간다.
WHATFROM_LLM_PROVIDER=fake
WHATFROM_LLM_BASE_URL=https://api.moonshot.ai/v1
WHATFROM_LLM_MODEL=kimi-k3
# 키는 MOONSHOT_API_KEY 또는 WHATFROM_LLM_API_KEY 중 아무 이름으로나 넣으면 된다.
MOONSHOT_API_KEY=

# 단계별 LLM. PLAN은 조건 추출 단계, RECOMMEND는 추천 단계다. 설정하지 않으면 위 공통 설정을 쓴다.
# API 키는 줄을 주석으로 둬야 공통 키를 쓴다. 빈 값으로 두면 인증 header를 보내지 않는다.
# EXTRA_BODY는 요청 본문에 덧붙일 JSON 객체다(reasoning 설정 등).
# WHATFROM_PLAN_LLM_BASE_URL=
# WHATFROM_PLAN_LLM_MODEL=
# WHATFROM_PLAN_LLM_API_KEY=
# WHATFROM_PLAN_LLM_EXTRA_BODY={"reasoning_effort": "none"}
# WHATFROM_RECOMMEND_LLM_BASE_URL=
# WHATFROM_RECOMMEND_LLM_MODEL=
# WHATFROM_RECOMMEND_LLM_API_KEY=
# WHATFROM_RECOMMEND_LLM_EXTRA_BODY={"reasoning_effort": "low"}
